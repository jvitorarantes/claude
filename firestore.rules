rules_version = '2';

// Regras do Firestore da Roça Feliz.
// Cole este arquivo em Firebase Console > Firestore Database > Regras e clique em Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // Cada jogador tem uma roça. Só o dono salva. Podem ver: o dono, os amigos
    // (lista friends) e quem recebeu um pedido de amizade do dono (lista sent),
    // para poder espiar a roça antes de aceitar.
    match /farms/{uid} {
      allow read: if signedIn() && (me() == uid
                  || me() in resource.data.get('friends', [])
                  || me() in resource.data.get('sent', []));
      allow write: if signedIn() && me() == uid
                   && request.resource.size() < 900000;

      // Visitas: o que um amigo fez na sua roça (ou um presente que mandou). Só amigos criam, sempre em
      // seu próprio nome. O dono lê e apaga ao aplicar.
      match /visits/{visitId} {
        allow create: if signedIn() && me() != uid
                      && request.resource.data.from == me()
                      && request.resource.data.t in ['help', 'steal', 'feed', 'stealA', 'gift']
                      && request.resource.size() < 2000
                      && me() in get(/databases/$(database)/documents/farms/$(uid)).data.get('friends', []);
        allow read, delete: if signedIn() && me() == uid;
      }

      // Pedidos de amizade: farms/{quemRecebe}/requests/{quemPediu}.
      // Quem pede cria (ou cancela) o seu; quem recebe lê e aceita/recusa apagando.
      match /requests/{fromUid} {
        allow create, update: if signedIn() && me() == fromUid && fromUid != uid
                              && request.resource.data.from == me()
                              && request.resource.size() < 2000;
        allow read, delete: if signedIn() && (me() == uid || me() == fromUid);
      }
    }

    // Códigos de amigo (6 letras) apontando para o jogador. Não podem ser trocados depois.
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == me()
                    && code.size() == 6;
    }
  }
}
